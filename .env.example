# =============================================================================
# Combined MCP Server - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# For local development, use .env.local with LocalStack endpoints

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For local development with LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566

# -----------------------------------------------------------------------------
# Redshift Configuration
# -----------------------------------------------------------------------------
REDSHIFT_CLUSTER_ID=my-redshift-cluster
REDSHIFT_DATABASE=mydb
REDSHIFT_HOST=my-cluster.xxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439

# S3 bucket for storing large query results (>100 rows)
REDSHIFT_RESULTS_BUCKET=my-redshift-results-bucket
REDSHIFT_RESULTS_PREFIX=query-results/

# -----------------------------------------------------------------------------
# Knowledgebase Configuration
# -----------------------------------------------------------------------------
# S3 location for markdown knowledge files
KNOWLEDGEBASE_S3_BUCKET=my-knowledgebase-bucket
KNOWLEDGEBASE_S3_PREFIX=docs/

# Secrets Manager secret name/ARN for PostgreSQL credentials
POSTGRES_SECRET_NAME=my-app/postgres-credentials

# Direct PostgreSQL connection (alternative to Secrets Manager, for local dev)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=vectordb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Bedrock Configuration
# -----------------------------------------------------------------------------
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_REGION=us-east-1

# -----------------------------------------------------------------------------
# Vector Store Configuration
# -----------------------------------------------------------------------------
VECTORSTORE_TABLE_NAME=kb_documents
VECTORSTORE_EMBEDDING_DIMENSION=1024

# Hybrid search weights (must sum to 1.0)
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_RRF_K=60

# Query cache settings
QUERY_CACHE_SIZE=30

# -----------------------------------------------------------------------------
# Health Check Server Configuration
# -----------------------------------------------------------------------------
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
