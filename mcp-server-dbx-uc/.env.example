# Databricks workspace URL (no trailing slash needed).
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Personal Access Token. Generate under
# Databricks Workspace -> Settings -> Developer -> Access tokens.
# NEVER commit a real token. This file is a template only.
DATABRICKS_PAT=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQL Warehouse ID (found in SQL Warehouses -> your warehouse -> Connection details).
DATABRICKS_WAREHOUSE_ID=0123456789abcdef

# Optional tuning (all have sane defaults if omitted).
# QUERY_TIMEOUT_SECONDS=30
# DEFAULT_ROW_LIMIT=1000
# MAX_SAMPLE_ROWS=100
# HISTORICAL_LOOKBACK_DAYS=7
# LOG_LEVEL=INFO
